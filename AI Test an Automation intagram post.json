    {
      "parameters": {
        "jsCode": "const scrapedItems = $('Edit Fields').all();\n\nconst inputItems = $input.all();\n\nconst existingJudul = new Set(\n  inputItems\n    .map(item => item.json?.judul)\n    .filter(judul => Boolean(judul) && typeof judul === 'string')\n);\n\nconst newItems = scrapedItems.filter(item => {\n  const judul = item.json?.judul;\n  return judul && !existingJudul.has(judul);\n});\n\nif (newItems.length > 0) {\n  return newItems.map(item => ({\n    json: {\n      ...item.json,\n      noNewData: false\n    }\n  }));\n}\n\nreturn [{ json: { noNewData: true } }];"
      },
